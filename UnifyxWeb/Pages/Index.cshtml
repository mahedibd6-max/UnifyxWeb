@section Scripts {
<script>
// Numbers strip: count up once when it comes into view (Bangla digits on the Bangla page).
(function () {
    var nums = document.querySelectorAll('.strip-num .num[data-to]');
    if (!nums.length || !('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var bn = document.documentElement.lang === 'bn', d = '০১২৩৪৫৬৭৮৯';
    var show = function (n) { var t = String(n); return bn ? t.replace(/[0-9]/g, function (c) { return d[c]; }) : t; };
    var io = new IntersectionObserver(function (es) {
        es.forEach(function (e) {
            if (!e.isIntersecting) return; io.unobserve(e.target);
            var el = e.target, from = +(el.dataset.from || 0), to = +el.dataset.to, suf = el.dataset.suffix || '', t0 = null;
            var step = function (ts) { if (!t0) t0 = ts; var k = Math.min(1, (ts - t0) / 1400), v = Math.round(from + (to - from) * (1 - Math.pow(1 - k, 3)));
                el.textContent = show(v) + suf; if (k < 1) requestAnimationFrame(step); };
            requestAnimationFrame(step);
        });
    }, { threshold: .6 });
    nums.forEach(function (n) { io.observe(n); });
})();
// Hero video: show only the still picture when the visitor prefers less motion.
(function () {
    var v = document.getElementById('heroVideo');
    if (v && window.matchMedia('(prefers-reduced-motion: reduce)').matches) { v.removeAttribute('autoplay'); v.pause(); }
})();
// Hero screen leans gently toward the mouse (off when the visitor prefers less motion).
(function () {
    var stage = document.getElementById('mockStage'), tilt = document.getElementById('mockTilt');
    if (!stage || !tilt || window.matchMedia('(prefers-reduced-motion: reduce)').matches || window.matchMedia('(hover: none)').matches) return;
    stage.addEventListener('mousemove', function (e) {
        var r = stage.getBoundingClientRect();
        var x = (e.clientX - r.left) / r.width - 0.5, y = (e.clientY - r.top) / r.height - 0.5;
        tilt.style.setProperty('--ry', (-14 + x * 12).toFixed(2) + 'deg');
        tilt.style.setProperty('--rx', (7 - y * 10).toFixed(2) + 'deg');
    });
    stage.addEventListener('mouseleave', function () { tilt.style.removeProperty('--ry'); tilt.style.removeProperty('--rx'); });
})();
</script>
}
