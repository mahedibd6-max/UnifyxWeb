@page
@model UnifyxWeb.Pages.IndexModel
@{
    var h = Model.Home;
    string Pick(string? en, string? bn, string fallback)
    {
        var v = L.IsBangla && !string.IsNullOrWhiteSpace(bn) ? bn : en;
        return string.IsNullOrWhiteSpace(v) ? fallback : v;
    }
    ViewData["Title"] = C.T("home.001", "ERP for Bangladesh: HR, Payroll, Inventory & Accounts", "বাংলাদেশের ERP: এইচআর, বেতন, স্টক ও হিসাব");
    var site = SiteOpt.Value;
    // This month's name for the sample "payroll done" card (changes by itself every month).
    string[] bnMonths = { "জানুয়ারি", "ফেব্রুয়ারি", "মার্চ", "এপ্রিল", "মে", "জুন", "জুলাই", "আগস্ট", "সেপ্টেম্বর", "অক্টোবর", "নভেম্বর", "ডিসেম্বর" };
    string thisMonth = L.IsBangla ? bnMonths[DateTime.Today.Month - 1]
        : System.Globalization.CultureInfo.GetCultureInfo("en-US").DateTimeFormat.GetMonthName(DateTime.Today.Month);
    var modules = new[]
    {
        ("👥", C.T("home.002", "HR & Attendance", "এইচআর ও হাজিরা"), C.T("home.003", "Employee records, leave, shifts and holidays, with biometric attendance.", "কর্মচারীর তথ্য, ছুটি, শিফট আর ছুটির দিন, Biometric হাজিরাসহ।"),
            new[] { C.T("home.004", "Leave requests with approval", "অনুমোদনসহ ছুটির আবেদন"), C.T("home.005", "ZKTeco biometric sync", "ZKTeco Biometric যুক্ত"), C.T("home.006", "Promotions and history", "পদোন্নতি ও ইতিহাস") }),
        ("💰", C.T("home.007", "Payroll & Income Tax", "বেতন ও আয়কর"), C.T("home.008", "Monthly salary with Bangladesh income tax, PF, gratuity, loans and bonus.", "বাংলাদেশের আয়কর, PF, গ্র্যাচুইটি, ঋণ আর বোনাসসহ মাসিক বেতন।"),
            new[] { C.T("home.009", "Payslips by email (PDF)", "ইমেইলে Payslip (PDF)"), C.T("home.010", "Tax slabs, rebate, TDS, certificates", "করের হার, রেয়াত, TDS, সনদ"), C.T("home.011", "Final settlement", "চূড়ান্ত নিষ্পত্তি") }),
        ("📦", C.T("home.012", "Inventory", "স্টক ব্যবস্থাপনা"), C.T("home.013", "Stores, items, requisitions and issues, with reorder alerts and stock counts.", "স্টোর, পণ্য, Requisition আর বিতরণ, কম স্টকের সতর্কতা আর স্টক গণনাসহ।"),
            new[] { C.T("home.014", "Requisition → approval → issue", "Requisition → অনুমোদন → বিতরণ"), C.T("home.015", "Store transfers", "স্টোর থেকে স্টোরে স্থানান্তর"), C.T("home.016", "Stock value and ledger", "স্টকের মূল্য ও খতিয়ান") }),
        ("🛒", C.T("home.017", "Purchase", "ক্রয়"), C.T("home.018", "Purchase orders, goods receipt (GRN) with signatures, supplier bills and payments.", "Purchase Order, স্বাক্ষরসহ GRN, Supplier bill আর পেমেন্ট।"),
            new[] { C.T("home.019", "PO approval", "PO অনুমোদন"), C.T("home.020", "Supplier dues by age", "বয়স অনুযায়ী Supplier দেনা"), C.T("home.021", "Purchase returns", "ক্রয় ফেরত") }),
        ("🧾", C.T("home.022", "Sales", "বিক্রয়"), C.T("home.023", "Customers, sales orders, invoices with VAT, collections and returns.", "Customer, Sales Order, VAT-সহ Invoice, আদায় আর ফেরত।"),
            new[] { C.T("home.024", "Mushak-ready invoices", "মূসক-উপযোগী Invoice"), C.T("home.025", "Customer dues and overdue", "Customer বকেয়া ও মেয়াদোত্তীর্ণ"), C.T("home.026", "Sales returns", "বিক্রয় ফেরত") }),
        ("📒", C.T("home.027", "Accounts", "হিসাব"), C.T("home.028", "Chart of accounts, vouchers with approval, and automatic posting from every module.", "হিসাবের খাত, অনুমোদনসহ Voucher, আর প্রতিটা মডিউল থেকে স্বয়ংক্রিয় এন্ট্রি।"),
            new[] { C.T("home.029", "Profit & Loss, Balance Sheet", "লাভ-ক্ষতি, ব্যালান্স শিট"), C.T("home.030", "Bank reconciliation", "ব্যাংক মিলকরণ"), C.T("home.031", "Budget vs actual", "বাজেট বনাম প্রকৃত") }),
        ("🏢", C.T("home.032", "Fixed Assets", "স্থায়ী সম্পদ"), C.T("home.033", "Asset register, depreciation, movements, disposals and barcode audits.", "সম্পদের তালিকা, অবচয়, স্থানান্তর, নিষ্পত্তি আর বারকোড দিয়ে অডিট।"),
            new[] { C.T("home.034", "Barcode / QR labels", "বারকোড / QR লেবেল"), C.T("home.035", "Audit with phone camera", "ফোনের ক্যামেরায় অডিট"), C.T("home.036", "Book value reports", "বুক ভ্যালু রিপোর্ট") }),
        ("🎫", C.T("home.037", "Issue Tracking", "কাজের টিকেট"), C.T("home.038", "Give work to people and departments, follow it up, and get reminders.", "মানুষ বা বিভাগকে কাজ দেওয়া, অগ্রগতি দেখা আর মনে করিয়ে দেওয়া।"),
            new[] { C.T("home.039", "Priorities and due dates", "অগ্রাধিকার ও শেষ তারিখ"), C.T("home.040", "Automatic reminders", "স্বয়ংক্রিয় রিমাইন্ডার"), C.T("home.041", "Ticket reports", "টিকেট রিপোর্ট") })
    };
}

@section Head {
    <script type="application/ld+json">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new object[] {
        new Dictionary<string, object> {
            ["@context"] = "https://schema.org", ["@type"] = "Organization", ["name"] = "Unifyx",
            ["url"] = Seo.Origin(ViewContext.HttpContext.Request), ["logo"] = Seo.Origin(ViewContext.HttpContext.Request) + "/img/og-image.jpg" },
        new Dictionary<string, object> {
            ["@context"] = "https://schema.org", ["@type"] = "SoftwareApplication", ["name"] = "Unifyx ERP",
            ["applicationCategory"] = "BusinessApplication", ["operatingSystem"] = "Web browser",
            ["description"] = "HR, payroll with Bangladesh income tax, inventory, purchase, sales, accounts and assets in one system.",
            ["areaServed"] = "Bangladesh", ["inLanguage"] = new[] { "en", "bn" },
            ["offers"] = new Dictionary<string, object> { ["@type"] = "Offer", ["priceCurrency"] = "BDT", ["url"] = Seo.Origin(ViewContext.HttpContext.Request) + "/en/Pricing" } }
    }))
    </script>
}


@{
    bool heroBanner = string.IsNullOrEmpty(h?.HeroImagePath);
    var heroTitle = Pick(h?.TitleEn, h?.TitleBn, L.T("HR, Payroll, Inventory & Accounts — one system.", "এইচআর, বেতন, স্টক আর হিসাব — এক সফটওয়্যারে।"));
    var heroParts = heroTitle.Split('—', 2);
}
<section class="hero" id="top">
    <div class="wrap hero-grid@(heroBanner ? " hero-banner" : "")">
        <div class="hero-copy">
            <span class="eyebrow">@Pick(h?.EyebrowEn, h?.EyebrowBn, L.T("ERP built for Bangladesh", "বাংলাদেশের জন্য তৈরি ERP"))</span>
            @* The part after "—" is highlighted. *@
            <h1>@if (heroParts.Length == 2) { @heroParts[0]<text>—</text><span class="hl">@heroParts[1]</span> } else { @heroTitle }</h1>
            <p class="lead">@Pick(h?.LeadEn, h?.LeadBn, L.T("Unifyx ERP brings your people, salaries, stock, purchases, sales and books together, following Bangladesh income tax and VAT rules — so the numbers always match.",
                                 "Unifyx ERP আপনার কর্মী, বেতন, স্টক, ক্রয়-বিক্রয় আর হিসাব এক জায়গায় আনে, বাংলাদেশের আয়কর আর ভ্যাটের নিয়ম মেনে — যাতে হিসাব সবসময় মেলে।"))</p>
            <div class="hero-cta">
                <a class="btn btn-accent btn-lg" href="@L.Url("Contact")#demo">@C.T("home.042", "Request a free demo", "ফ্রি ডেমো দেখুন")</a>
                <a class="btn btn-ghost btn-lg" href="#modules">@C.T("home.043", "See the modules", "মডিউলগুলো দেখুন")</a>
            </div>
            <ul class="trust">
                <li>@C.T("home.044", "Separate database for each company", "প্রতিটা প্রতিষ্ঠানের আলাদা ডাটাবেস")</li>
                <li>@C.T("home.045", "Help in Bangla", "বাংলায় সাহায্য")</li>
                <li>@C.T("home.046", "Take only the modules you need", "যতটুকু দরকার, ততটুকুই নিন")</li>
            </ul>
        </div>
        @if (!string.IsNullOrEmpty(h?.HeroImagePath))
        {
            <img class="hero-shot" src="@h.HeroImagePath" alt="@C.T("home.047", "Unifyx ERP screen", "Unifyx ERP-এর পাতা")" />
        }
        else
        {
        <div class="hero-video-stage">
            @* 18-second silent loop (2.2:1, story on the right half): separate sheets → one system → live dashboard → Unifyx ERP info. *@
            <video class="hero-video" id="heroVideo" autoplay muted loop playsinline preload="metadata"
                   poster="/video/unifyx-hero-banner-poster.jpg" width="2112" height="960"
                   aria-label="@C.T("home.048", "Business Overview screen of Unifyx ERP", "Unifyx ERP-এর Business Overview পাতা")">
                <source src="/video/unifyx-hero-banner.mp4" type="video/mp4" />
            </video>
        </div>
        }
    </div>
</section>

<div class="strip">
    <div class="wrap">
        <div class="strip-grid@(Model.Stats.Count == 0 ? " strip-num" : "")">
        @{
            var stripIcons = new[] {
                "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"2\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"2\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"2\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"2\"/></svg>",
                "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6z\"/><path d=\"M8.5 12l2.5 2.5 4.5-5\"/></svg>",
                "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M8 20h8M12 16v4\"/></svg>",
                "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 5h16v11H9l-5 4z\"/><path d=\"M8 9.5h8M8 12.5h5\"/></svg>" };
        }
        @if (Model.Stats.Count > 0)
        {
            int si = 0;
            foreach (var s in Model.Stats)
            {
                <div class="strip-item"><span class="strip-ic">@Html.Raw(stripIcons[si++ % 4])</span><div><strong>@s.Value</strong><span>@Pick(s.LabelEn, s.LabelBn, s.LabelEn)</span></div></div>
            }
        }
        else
        {
            @* Big numbers that count up when the strip comes into view (see the script at the bottom). *@
            <div class="strip-item"><strong class="num" data-to="8">@L.T("8", "৮")</strong><span>@C.T("home.s11", "modules working together in one system", "টা মডিউল, এক সফটওয়্যারে একসাথে")</span></div>
            <div class="strip-item"><strong class="num" data-from="2000" data-to="2023">@L.T("2023", "২০২৩")</strong><span>@C.T("home.s12", "Income Tax Act and VAT rules built in", "সালের আয়কর আইন আর ভ্যাটের নিয়ম যুক্ত")</span></div>
            <div class="strip-item"><strong class="num">@L.T("0", "০")</strong><span>@C.T("home.s13", "installs: runs in the browser on any device", "ইনস্টল লাগে না: যেকোনো ডিভাইসের ব্রাউজারে চলে")</span></div>
            <div class="strip-item"><strong class="num" data-to="100" data-suffix="%">@L.T("100%", "১০০%")</strong><span>@C.T("home.s14", "help and guides in Bangla", "বাংলায় সাহায্য আর গাইড")</span></div>
        }
        </div>
    </div>
</div>

<section id="modules">
    <div class="wrap">
        <div class="section-head">
            <span class="eyebrow">@C.T("home.067", "Modules", "মডিউল")</span>
            <h2>@C.T("home.068", "Everything a growing business runs on", "একটা প্রতিষ্ঠান চালাতে যা যা লাগে")</h2>
            <p>@C.T("home.069", "Start with what you need today and add more later. The modules share one set of data, so nothing is entered twice.", "আজ যা দরকার তা দিয়ে শুরু করুন, পরে আরও যোগ করুন। সব মডিউল একই তথ্য ব্যবহার করে, তাই কোনো কিছু দুবার এন্ট্রি দিতে হয় না।")</p>
        </div>
        <div class="grid-4">
            @{
                // Modules saved in Admin → Modules; while none is saved, the built-in 8.
                var shownModules = Model.Modules.Count > 0
                    ? Model.Modules.Select(m => (m.Icon ?? "▣", Pick(m.NameEn, m.NameBn, m.NameEn), Pick(m.TextEn, m.TextBn, ""),
                        Pick(m.PointsEn, m.PointsBn, "").Replace("\r", "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))).ToArray()
                    : modules;
            }
            @foreach (var (icon, name, text, points) in shownModules)
            {
                <div class="card">
                    <div class="icon" aria-hidden="true">@icon</div>
                    <h3>@name</h3>
                    <p>@text</p>
                    @if (points.Length > 0) { <ul>@foreach (var p in points) { <li>@p</li> }</ul> }
                </div>
            }
        </div>
    </div>
</section>

@{ var otherProducts = PM.Others; }
@if (otherProducts.Count > 0)
{
<section class="more-products">
    <div class="wrap">
        <div class="section-head">
            <span class="eyebrow">@C.T("home.p01", "More from Unifyx", "Unifyx-এর আরও পণ্য")</span>
            <h2>@C.T("home.p02", "Software made for your kind of business", "আপনার ধরনের ব্যবসার জন্য সফটওয়্যার")</h2>
            <p>@C.T("home.p03", "Simple, separate products for shops, clinics and schools — ready in minutes.", "দোকান, ক্লিনিক আর স্কুলের জন্য আলাদা সহজ সফটওয়্যার — কয়েক মিনিটেই চালু।")</p>
        </div>
        <div class="promo-grid">
            @foreach (var op in otherProducts)
            {
                <a class="card product-promo" href="@PM.Link(op)">
                    <div class="icon" aria-hidden="true">@(string.IsNullOrEmpty(op.Icon) ? "▣" : op.Icon)</div>
                    <div>
                        <h3>@PM.Name(op) @if (op.ComingSoon) { <em class="dd-soon">@C.T("layout.p03", "Coming soon", "শিগগিরই আসছে")</em> }</h3>
                        @if (!string.IsNullOrWhiteSpace(PM.Tagline(op))) { <p>@PM.Tagline(op)</p> }
                        <span class="promo-link">@C.T("home.p04", "See details", "বিস্তারিত দেখুন") →</span>
                    </div>
                </a>
            }
        </div>
    </div>
</section>
}

<section class="section-alt">
    <div class="wrap">
        <div class="section-head">
            <span class="eyebrow">@C.T("home.070", "How it works", "কীভাবে কাজ করে")</span>
            <h2>@C.T("home.071", "Enter once. Approve. The books update themselves.", "একবার এন্ট্রি। অনুমোদন। হিসাব নিজেই হালনাগাদ।")</h2>
        </div>
        <div class="grid-3 steps">
            <div class="card step">
                <h3>@C.T("home.072", "People do their own part", "প্রত্যেকে নিজের অংশ করেন")</h3>
                <p>@C.T("home.073", "Employees apply for leave and request items; store keepers receive goods; sales staff raise invoices — each in their own screen.", "কর্মীরা ছুটি আর মালামাল চান, স্টোর কিপার মাল গ্রহণ করেন, বিক্রয়কর্মী Invoice করেন — প্রত্যেকে নিজের পাতায়।")</p>
            </div>
            <div class="card step">
                <h3>@C.T("home.074", "Managers approve", "ব্যবস্থাপক অনুমোদন দেন")</h3>
                <p>@C.T("home.075", "Set your own approval steps. Approvers get notified and sign digitally; every change is kept in the audit trail.", "নিজের মতো অনুমোদনের ধাপ ঠিক করুন। অনুমোদনকারী নোটিফিকেশন পান আর ডিজিটাল স্বাক্ষর দেন; প্রতিটা পরিবর্তন Audit Trail-এ থাকে।")</p>
            </div>
            <div class="card step">
                <h3>@C.T("home.076", "Accounts post automatically", "হিসাব নিজে তৈরি হয়")</h3>
                <p>@C.T("home.077", "Salaries, stock, purchases and sales post to the ledger by your rules. Profit, cash and dues are always up to date.", "বেতন, স্টক, ক্রয় আর বিক্রয় আপনার নিয়মে খাতায় চলে যায়। লাভ, নগদ আর বকেয়া সবসময় হালনাগাদ থাকে।")</p>
            </div>
        </div>
    </div>
</section>

<section id="features">
    <div class="wrap split">
        <div>
            <span class="eyebrow">@C.T("home.078", "For owners and directors", "মালিক ও পরিচালকদের জন্য")</span>
            <h2>@C.T("home.079", "See how the company is doing — on one page", "প্রতিষ্ঠান কেমন চলছে — এক পাতায়")</h2>
