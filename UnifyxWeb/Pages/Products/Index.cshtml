@page "{slug?}"
@model UnifyxWeb.Pages.Products.IndexModel
@{
    var p = Model.One;
    ViewData["Title"] = p == null ? C.T("products.001", "Products", "পণ্য") : PM.Name(p);
    if (p != null)
    {
        // Shop products are sold as "Unifyx", not "Unifyx ERP".
        ViewData["Brand"] = "Unifyx";
        if (!string.IsNullOrWhiteSpace(PM.SeoTitle(p))) ViewData["FullTitle"] = PM.SeoTitle(p);
        var seoDesc = !string.IsNullOrWhiteSpace(PM.SeoDescription(p)) ? PM.SeoDescription(p) : PM.Tagline(p);
        if (!string.IsNullOrWhiteSpace(seoDesc)) ViewData["Description"] = seoDesc;
        if (!string.IsNullOrEmpty(p.ImagePath)) ViewData["OgImage"] = p.ImagePath;
    }
}
@section Head {
    @if (p != null)
    {
        var origin = Seo.Origin(ViewContext.HttpContext.Request);
        var ld = new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org", ["@type"] = "SoftwareApplication",
            ["name"] = PM.Name(p),
            ["description"] = ViewData["Description"] as string ?? PM.Tagline(p),
            ["applicationCategory"] = "BusinessApplication",
            ["operatingSystem"] = "Web browser",
            ["inLanguage"] = new[] { "bn", "en" },
            ["url"] = Seo.Url(origin, L.Code, "Products/" + p.Slug),
            ["publisher"] = new Dictionary<string, object> { ["@type"] = "Organization", ["name"] = "Unifyx", ["url"] = origin }
        };
        if (!string.IsNullOrEmpty(p.ImagePath)) { ld["image"] = p.ImagePath.StartsWith("http") ? p.ImagePath : origin + p.ImagePath; }
        if (p.PriceFrom is int price)
        {
            ld["offers"] = new Dictionary<string, object> { ["@type"] = "Offer", ["price"] = price.ToString(), ["priceCurrency"] = "BDT",
                ["availability"] = p.ComingSoon ? "https://schema.org/PreOrder" : "https://schema.org/InStock" };
        }
        var ldJson = System.Text.Json.JsonSerializer.Serialize(ld, new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping }).Replace("</", "<\\/");
        <script type="application/ld+json">@Html.Raw(ldJson)</script>
    }
}
@if (p == null)
{
    <div class="page-head"><div class="wrap">
        <span class="eyebrow">@C.T("products.002", "Products", "পণ্য")</span>
        <h1>@C.T("products.003", "Software for every part of your business", "ব্যবসার প্রতিটা কাজের জন্য সফটওয়্যার")</h1>
        <p class="muted" style="max-width:640px">@C.T("products.004", "Choose what fits your business today, and add more as you grow.", "আজ যা দরকার তা দিয়ে শুরু করুন, বড় হলে আরও যোগ করুন।")</p>
    </div></div>
    <section><div class="wrap">
        @if (Model.Items.Count == 0)
        {
            <p class="muted">@C.T("products.010", "No products yet.", "এখনো কোনো পণ্য যোগ করা হয়নি।")</p>
        }
        else
        {
            <div class="product-grid">
                @foreach (var x in Model.Items)
                {
                    <a class="card product-card" href="@PM.Link(x)">
                        @if (!string.IsNullOrEmpty(x.ImagePath)) { <img src="@x.ImagePath" alt="" loading="lazy" /> }
                        <div class="product-top">
                            <span class="product-ic" aria-hidden="true">@(string.IsNullOrEmpty(x.Icon) ? "▣" : x.Icon)</span>
                            @if (x.ComingSoon) { <em class="dd-soon">@C.T("layout.p03", "Coming soon", "শিগগিরই আসছে")</em> }
                        </div>
                        <h3>@PM.Name(x)</h3>
                        @if (!string.IsNullOrWhiteSpace(PM.Tagline(x))) { <p>@PM.Tagline(x)</p> }
                        <span class="product-more">@C.T("products.005", "Learn more", "বিস্তারিত") →</span>
                    </a>
                }
            </div>
        }
    </div></section>
}
else
{
    var features = PM.Features(p);
    // Lines written as "icon | name | text | point; point; point" show as module cards (like the home page);
    // plain lines show as the ✓ list.
    var cards = features.Where(UnifyxWeb.ProductMenu.IsCard).Select(UnifyxWeb.ProductMenu.Card).ToArray();
    var plain = features.Where(f => !UnifyxWeb.ProductMenu.IsCard(f)).ToArray();
    <div class="page-head product-head"><div class="wrap">
        <a href="@L.Url("Products")">← @C.T("products.006", "All products", "সব পণ্য")</a>
        <div class="product-title">
            <span class="product-ic big" aria-hidden="true">@(string.IsNullOrEmpty(p.Icon) ? "▣" : p.Icon)</span>
            <div>
                <h1>@PM.Name(p) @if (p.ComingSoon) { <em class="dd-soon">@C.T("layout.p03", "Coming soon", "শিগগিরই আসছে")</em> }</h1>
                @if (!string.IsNullOrWhiteSpace(PM.Tagline(p))) { <p class="muted lead">@PM.Tagline(p)</p> }
            </div>
        </div>
        <div class="hero-cta">
            @if (!string.IsNullOrEmpty(p.DemoUrl)) { <a class="btn btn-accent btn-lg" href="@p.DemoUrl">@C.T("products.013", "Try the demo", "ডেমো চালিয়ে দেখুন") ↗</a> }
            else { <a class="btn btn-accent btn-lg" href="@L.Url("Contact")#demo">@C.T("products.008", "Request a demo", "ডেমো দেখুন")</a> }
            @if (!string.IsNullOrEmpty(p.AppUrl)) { <a class="btn btn-ghost btn-lg" href="@p.AppUrl">@C.T("products.009", "Get started", "শুরু করুন") ↗</a> }
        </div>
    </div></div>
    <section><div class="wrap product-body @(string.IsNullOrEmpty(p.ImagePath) ? "no-pic" : "")">
        <div class="prose">
            @TextFormat.Paragraphs(PM.Description(p))
            @if (plain.Length > 0)
            {
                <h2>@C.T("products.007", "What you get", "যা পাবেন")</h2>
                <ul class="product-features">@foreach (var f in plain) { <li>@f</li> }</ul>
            }
        </div>
        @if (!string.IsNullOrEmpty(p.ImagePath)) { <img class="product-shot" src="@p.ImagePath" alt="@PM.Name(p)" /> }
    </div></section>
    @if (cards.Length > 0)
    {
        <section class="section-alt"><div class="wrap">
            <div class="section-head">
                <span class="eyebrow">@C.T("products.007", "What you get", "যা পাবেন")</span>
                <h2>@C.T("products.011", "Everything you need, in one place", "যা যা লাগে, সব এক জায়গায়")</h2>
            </div>
            <div class="grid-4">
                @foreach (var c in cards)
                {
                    <div class="card">
                        <div class="icon" aria-hidden="true">@c.Icon</div>
                        <h3>@c.Name</h3>
                        @if (!string.IsNullOrWhiteSpace(c.Text)) { <p>@c.Text</p> }
                        @if (c.Points.Length > 0) { <ul>@foreach (var pt in c.Points) { <li>@pt</li> }</ul> }
                    </div>
                }
            </div>
            @if (!string.IsNullOrEmpty(p.AppUrl))
            {
                <div class="hero-cta" style="justify-content:center;margin-top:32px">
                    <a class="btn btn-accent btn-lg" href="@p.AppUrl">@C.T("products.012", "Start free", "ফ্রি চালু করুন") ↗</a>
                    @if (!string.IsNullOrEmpty(p.DemoUrl)) { <a class="btn btn-ghost btn-lg" href="@p.DemoUrl">@C.T("products.013", "Try the demo", "ডেমো চালিয়ে দেখুন") ↗</a> }
                    else { <a class="btn btn-ghost btn-lg" href="@L.Url("Contact")#demo">@C.T("products.008", "Request a demo", "ডেমো দেখুন")</a> }
                </div>
            }
        </div></section>
    }
}
