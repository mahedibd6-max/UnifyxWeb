@page
@model UnifyxWeb.Pages.Admin.ProductsModel
@{ ViewData["Title"] = "Products"; }
<h2>Products</h2>
<p class="muted">Products show under <b>Products ▾</b> in the website menu, each with its own page. While none is added (or all are hidden), the menu shows <b>Modules</b> as before.</p>
@if (Model.Saved != null) { <div class="ok-msg">@Model.Saved</div> }
<div class="panel">
    @if (Model.Items.Count == 0) { <p class="muted">No products yet. Start with <b>Unifyx ERP</b> and tick "main product".</p> }
    @foreach (var p in Model.Items)
    {
        <div style="display:flex;justify-content:space-between;gap:1rem;align-items:center;border-bottom:1px solid var(--line);padding:.6rem 0">
            <div><b>@p.SortOrder.</b> <span style="font-size:1.2rem">@p.Icon</span> @p.NameEn
                <span class="muted">· /Products/@p.Slug</span>
                @if (p.UseHomePage) { <span class="tx-badge">main product</span> }
                @if (p.ComingSoon) { <span class="tx-badge">coming soon</span> }
                @if (!p.IsActive) { <span class="muted">(hidden)</span> }</div>
            <div style="display:flex;gap:.5rem">
                @if (p.IsActive) { <a class="btn btn-ghost btn-sm" href="@(p.UseHomePage ? "/en#modules" : "/en/Products/" + p.Slug)" target="_blank" rel="noopener">View ↗</a> }
                <a class="btn btn-ghost btn-sm" href="?edit=@p.Id">Edit</a>
                <form method="post" asp-page-handler="Delete" asp-route-id="@p.Id" class="inline" onsubmit="return confirm('Delete this product?')">
                    <button class="btn btn-ghost btn-sm" type="submit">Delete</button>
                </form>
            </div>
        </div>
    }
</div>
<form method="post" asp-page-handler="Save" enctype="multipart/form-data" class="panel">
    <h3>@(Model.Input.Id == 0 ? "Add a product" : "Change product")</h3>
    <input type="hidden" asp-for="Input.Id" />
    <div asp-validation-summary="All" class="validation-summary-errors"></div>
    <div class="form-grid">
        <div class="field"><label asp-for="Input.NameEn">Name (English)</label><input asp-for="Input.NameEn" placeholder="Unifyx POS" /></div>
        <div class="field"><label asp-for="Input.NameBn">Name (বাংলা)</label><input asp-for="Input.NameBn" /></div>
        <div class="field"><label asp-for="Input.TaglineEn">One-line summary (English)</label><input asp-for="Input.TaglineEn" placeholder="Billing and stock for shops" /><div class="hint">Shows in the menu and on the product card.</div></div>
        <div class="field"><label asp-for="Input.TaglineBn">One-line summary (বাংলা)</label><input asp-for="Input.TaglineBn" /></div>
        <div class="field"><label asp-for="Input.DescriptionEn">About the product (English)</label><textarea asp-for="Input.DescriptionEn" rows="6"></textarea><div class="hint">Leave an empty line between paragraphs.</div></div>
        <div class="field"><label asp-for="Input.DescriptionBn">About the product (বাংলা)</label><textarea asp-for="Input.DescriptionBn" rows="6"></textarea></div>
        <div class="field"><label asp-for="Input.FeaturesEn">What you get (English)</label><textarea asp-for="Input.FeaturesEn" rows="5" placeholder="One per line"></textarea><div class="hint">One per line — each shows with a ✓.<br />
            For a card like the home page modules, write: <code>icon | name | one-line text | point; point; point</code><br />
            e.g. <code>📱 | IMEI tracking | Every phone kept by its IMEI | Bought from whom; In stock or sold; Warranty end date</code></div></div>
        <div class="field"><label asp-for="Input.FeaturesBn">What you get (বাংলা)</label><textarea asp-for="Input.FeaturesBn" rows="5"></textarea><div class="hint">একই নিয়ম: <code>আইকন | নাম | এক লাইনের বর্ণনা | পয়েন্ট; পয়েন্ট; পয়েন্ট</code></div></div>
        <div class="field"><label asp-for="Input.Icon">Icon</label><input asp-for="Input.Icon" placeholder="🧾" maxlength="8" /><div class="hint">Click an icon below, or type / paste any emoji.</div><partial name="_IconPicker" /></div>
        <div class="field"><label asp-for="Input.Slug">Page address</label><input asp-for="Input.Slug" placeholder="made from the name" /><div class="hint">/en/Products/<b>this-part</b>. Leave empty to make it from the English name.</div></div>
        <div class="field"><label asp-for="Input.SeoTitleEn">Google title (English)</label><input asp-for="Input.SeoTitleEn" maxlength="70" placeholder="Mobile shop software — IMEI, due, warranty | Unifyx Shop" /><div class="hint">What Google shows as the blue link (up to 60–70 letters). Empty = the name.</div></div>
        <div class="field"><label asp-for="Input.SeoTitleBn">Google title (বাংলা)</label><input asp-for="Input.SeoTitleBn" maxlength="70" /><div class="hint">যে শব্দ লিখে মানুষ খোঁজে, সেগুলো আগে রাখুন।</div></div>
        <div class="field"><label asp-for="Input.SeoDescriptionEn">Google description (English)</label><textarea asp-for="Input.SeoDescriptionEn" rows="3" maxlength="300"></textarea><div class="hint">The two grey lines under the link (about 150–160 letters). Empty = the one-line summary.</div></div>
        <div class="field"><label asp-for="Input.SeoDescriptionBn">Google description (বাংলা)</label><textarea asp-for="Input.SeoDescriptionBn" rows="3" maxlength="300"></textarea></div>
        <div class="field"><label asp-for="Input.PriceFrom">Price from (Tk per month, optional)</label><input asp-for="Input.PriceFrom" type="number" min="0" step="1" placeholder="500" /><div class="hint">Told to Google as the starting price. Empty = no price.</div></div>
        <div class="field"><label asp-for="Input.AppUrl">"Open" button link (optional)</label><input asp-for="Input.AppUrl" type="text" placeholder="app.unifyxerp.com" /><div class="hint">Where customers log in to this product.</div></div>
        <div class="field"><label asp-for="Input.SortOrder">Order</label><input asp-for="Input.SortOrder" /><div class="hint">1 shows first.</div></div>
        <div class="field">
            <label asp-for="Image">Picture (optional)</label>
            @if (!string.IsNullOrEmpty(Model.Input.ImagePath))
            {
                <img src="@Model.Input.ImagePath" alt="" style="max-width:220px;border-radius:8px;margin-bottom:.4rem" />
                <div><label><input type="checkbox" asp-for="RemoveImage" /> Remove picture</label></div>
            }
            <input asp-for="Image" type="file" accept=".jpg,.jpeg,.png,.webp" />
            <div class="hint">A screenshot of the product. JPG, PNG or WebP, up to 3 MB.</div>
        </div>
        <div class="field">
            <label><input type="checkbox" asp-for="Input.IsActive" /> Show on the website</label>
            <label><input type="checkbox" asp-for="Input.UseHomePage" /> Main product — the menu opens the home page</label>
            <label><input type="checkbox" asp-for="Input.ComingSoon" /> Show "Coming soon"</label>
        </div>
    </div>
    <button class="btn btn-primary" type="submit" style="margin-top:1rem">Save</button>
    @if (Model.Input.Id != 0) { <a class="btn btn-ghost" href="/admin/products" style="margin-top:1rem">Cancel</a> }
</form>
